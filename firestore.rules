rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /customers/{customerId} {

      // هر کسی می‌تواند مشتری جدید ثبت کند (فرم سایت)، ولی فقط با ساختار مجاز
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'phones', 'title', 'description', 'address', 'category',
                         'type', 'registerGoogle', 'registerNeshan', 'hasPhoto', 'createdAt',
                         'lat', 'lng', 'instagram', 'whatsapp', 'telegram'
                       ])
                    && request.resource.data.keys().hasAll(['name', 'phones'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.phones is list
                    && request.resource.data.phones.size() >= 1
                    && request.resource.data.phones.size() <= 10
                    && request.resource.data.get('title', '').size() <= 120
                    && request.resource.data.get('description', '').size() <= 500
                    && request.resource.data.get('address', '').size() <= 500
                    && request.resource.data.get('type', 'business') in ['business', 'personal']
                    && request.resource.data.get('lat', 0) is number
                    && request.resource.data.get('lng', 0) is number
                    && request.resource.data.get('instagram', '').size() <= 64
                    && request.resource.data.get('whatsapp', '').size() <= 20
                    && request.resource.data.get('telegram', '').size() <= 64;

      // خواندن، ویرایش و حذف فقط برای ادمین
      // YOUR_ADMIN_UID را با UID کاربر ادمین (از Authentication → Users) جایگزین کن
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == 'YOUR_ADMIN_UID';
    }
  }
}
