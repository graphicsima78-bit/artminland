rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /customers/{customerId} {

      // ثبت مشتری جدید (از طریق فرم عمومی سایت با فیلدهای مجاز)
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'manager', 'phones', 'title', 'description', 'address', 'category',
                         'type', 'registerGoogle', 'registerNeshan', 'hasPhoto', 'createdAt',
                         'lat', 'lng', 'email', 'website', 'instagram', 'whatsapp', 'telegram',
                         'eitaa', 'bale', 'rubika'
                       ])
                    && request.resource.data.keys().hasAll(['name', 'phones'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.get('manager', '').size() <= 120
                    && request.resource.data.phones is list
                    && request.resource.data.phones.size() >= 1
                    && request.resource.data.phones.size() <= 10
                    && request.resource.data.get('title', '').size() <= 120
                    && request.resource.data.get('description', '').size() <= 500
                    && request.resource.data.get('address', '').size() <= 500
                    && request.resource.data.get('type', 'business') in ['business', 'personal']
                    && request.resource.data.get('lat', 0) is number
                    && request.resource.data.get('lng', 0) is number
                    && request.resource.data.get('email', '').size() <= 100
                    && request.resource.data.get('website', '').size() <= 200
                    && request.resource.data.get('instagram', '').size() <= 64
                    && request.resource.data.get('whatsapp', '').size() <= 20
                    && request.resource.data.get('telegram', '').size() <= 64
                    && request.resource.data.get('eitaa', '').size() <= 64
                    && request.resource.data.get('bale', '').size() <= 64
                    && request.resource.data.get('rubika', '').size() <= 64;

      // خواندن، ویرایش و حذف فقط برای کاربرانی که لاگین کرده‌اند (پنل ادمین)
      allow read, update, delete: if request.auth != null;
    }
  }
}
